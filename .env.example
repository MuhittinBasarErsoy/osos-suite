# Üretim gizli değerleri. Bu dosyayı `.env` olarak kopyalayıp güçlü değerlerle doldurun.
#   cp .env.example .env
# (.env git'e gönderilmez — .gitignore hariç tutar.)

# SQL Server 'sa' şifresi (en az 8 karakter, büyük/küçük harf + rakam + sembol)
MSSQL_SA_PASSWORD=DEGISTIR_Guclu_Parola_123!

# JWT imza anahtarı (en az 32 karakter, rastgele). Örn üretmek için:
#   openssl rand -base64 48
JWT_KEY=DEGISTIR_uzun_rastgele_anahtar_en_az_32_karakter
